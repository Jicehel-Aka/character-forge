# Copie ce fichier en .env (jamais commité) pour le serveur local : npm run dev

# Clé Gemini (https://aistudio.google.com/apikey). Sans clé : serveur actif, fonctions IA désactivées.
GEMINI_API_KEY=

# Modèle Gemini. Défaut sûr : gemini-3.8-flash (modèle stable, vérifié sur ai.google.dev/gemini-api/docs/models).
# GEMINI_MODEL=gemini-3.8-flash

# Jeton d'accès optionnel : s'il est défini, /api/* (sauf /api/health) exige l'en-tête X-Api-Token.
# À définir dès que le serveur est joignable par d'autres personnes que toi.
# API_TOKEN=

# Réseau : par défaut le serveur n'écoute qu'en local (127.0.0.1).
# HOST=127.0.0.1
# PORT=3000
# Derrière un reverse proxy (pour que la limite de débit voie la vraie IP) : TRUST_PROXY=1
# TRUST_PROXY=

# Limites
# MAX_BODY_MB=8
# RATE_LIMIT_PER_MIN=20
# EXPORT_RATE_LIMIT_PER_MIN=3
